{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "types": ["$app/types", "vite/client", "bun", "chrome"],
    "strict": true,
    "paths": {
      "$shared/*": ["../shared/src/*"],
      "$policy/*": ["../shared/policy/*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts", "tests", "*"]
}
