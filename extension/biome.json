{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "*.js",
      "*.json",
      "*.ts",
      "src/**/*.html",
      "src/**/*.ts",
      "src/**/*.svelte",
      "src/**/*.css",
      "src/**/*.json",
      "scripts/**/*.ts",
      "tests/**/*.ts"
    ],
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noNoninteractiveElementInteractions": "error"
      },
      "complexity": {
        "noDivRegex": "error",
        "noExcessiveCognitiveComplexity": "error",
        "noExcessiveNestedTestSuites": "error",
        "noForEach": "error",
        "noImplicitCoercions": "error",
        "noRedundantDefaultExport": "error",
        "noUselessCatchBinding": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefined": "error",
        "useArrayFind": "error",
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 5
          }
        },
        "useSimplifiedLogicExpression": "error",
        "useWhile": "error",
        "useLiteralKeys": "off",
        "noExcessiveNestedCallbacks": "error",
        "noUnnecessaryTemplateExpression": "error",
        "useArraySome": "error",
        "useRegexpTest": "error"
      },
      "correctness": {
        "noGlobalDirnameFilename": "error",
        "noNodejsModules": "error",
        "noPrivateImports": "error",
        "noProcessGlobal": "error",
        "noUndeclaredDependencies": "error",
        "noUnusedInstantiation": "error",
        "useImportExtensions": "error",
        "useJsonImportAttributes": "error",
        "useSingleJsDocAsterisk": "error"
      },
      "nursery": {
        "noBaseToString": "error",
        "noExtendNative": "error",
        "noFloatingPromises": "error",
        "noInvalidFileInputAccept": "error",
        "noMeaninglessVoidOperator": "error",
        "noMisusedPromises": "error",
        "noNegationInEqualityCheck": "error",
        "noNonScalableViewport": "error",
        "noObsoleteTags": "error",
        "noRestrictedDependencies": "error",
        "noSelfImport": "error",
        "noSvelteAtDebugTags": "error",
        "noSvelteAtHtmlTags": "error",
        "noSvelteExportLet": "error",
        "noSvelteLegacyConst": "error",
        "noSvelteUnnecessaryStateWrap": "error",
        "noTailwindRawColors": "error",
        "noThisOutsideOfClass": "error",
        "noUndeclaredCustomProperties": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnsafePlusOperands": "error",
        "noUnsafeTypeAssertion": "error",
        "noUnusedClasses": "error",
        "noUselessTypeConversion": "error",
        "useAwaitThenable": "error",
        "useBetterDomTraversing": "error",
        "useConsistentFunctionStyle": {
          "level": "error",
          "options": {
            "style": "declaration"
          }
        },
        "useControlLabel": "error",
        "useDisposables": "error",
        "useExhaustiveSwitchCases": "error",
        "useIncludes": "error",
        "useLogicalProperties": "error",
        "useNamedLayer": "error",
        "useNullishCoalescing": "error",
        "usePromiseRejectErrors": "error",
        "useRegexpExec": "error",
        "useStrictBooleanExpressions": "error",
        "useStringStartsEndsWith": "error",
        "useSvelteRequireEachKey": "error",
        "useTailwindShorthandClasses": "error",
        "useValidTestTitle": "error",
        "useTailwindSortedClasses": "error"
      },
      "performance": {
        "noAwaitInLoops": "error",
        "noBarrelFile": "error",
        "noDelete": "error",
        "noNamespaceImport": "error",
        "noReExportAll": "error",
        "useTopLevelRegex": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noCommonJs": "error",
        "noContinue": "error",
        "noDefaultExport": "error",
        "noDoneCallback": "error",
        "noEnum": "error",
        "noExcessiveClassesPerFile": "error",
        "noExportedImports": "error",
        "noInferrableTypes": "error",
        "noMultiAssign": "error",
        "noMultilineString": "error",
        "noNamespace": "error",
        "noNegationElse": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "noParameterProperties": "error",
        "noProcessEnv": "error",
        "noShoutyConstants": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noValueAtRule": "error",
        "noYodaExpression": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useConsistentEnumValueType": "error",
        "useConsistentMemberAccessibility": "error",
        "useConsistentMethodSignatures": "error",
        "useConsistentObjectDefinitions": "error",
        "useConsistentTypeDefinitions": "error",
        "useDefaultParameterLast": "error",
        "useDestructuring": "error",
        "useEnumInitializers": "error",
        "useErrorCause": "error",
        "useExplicitLengthCheck": "error",
        "useFilenamingConvention": "error",
        "useForOf": "error",
        "useGlobalThis": "error",
        "useGroupedAccessorPairs": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": ["camelCase", "PascalCase"]
              }
            ]
          }
        },
        "useNodeAssertStrict": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useReadonlyClassProperties": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useSingleVarDeclarator": "error",
        "useSpreadOverApply": "error",
        "useSymbolDescription": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error",
        "useUnifiedTypeSignatures": "error",
        "noInlineStyles": "error",
        "noTopLevelLiterals": "error",
        "useConsistentTestIt": {
          "level": "error",
          "options": {
            "function": "test",
            "withinDescribe": "test"
          }
        },
        "useImportsFirst": "error",
        "useNamedCaptureGroup": "error",
        "useReduceTypeParameter": "error",
        "useTestHooksInOrder": "error",
        "useTestHooksOnTop": "error",
        "useThisInClassMethods": "error",
        "useUnicodeRegex": "error",
        "useVarsOnTop": "error"
      },
      "suspicious": {
        "noAlert": "error",
        "noBitwiseOperators": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "debug"]
          }
        },
        "noConstantBinaryExpressions": "error",
        "noDeprecatedImports": "error",
        "noDuplicateDependencies": "error",
        "noDuplicateTestHooks": "error",
        "noEmptyBlockStatements": "error",
        "noEmptySource": "error",
        "noEqualsToNull": "error",
        "noEvolvingTypes": "error",
        "noExportsInTest": "error",
        "noFocusedTests": "error",
        "noForIn": "error",
        "noImportCycles": "error",
        "noMisplacedAssertion": "error",
        "noNestedPromises": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noReturnAssign": "error",
        "noShadow": "error",
        "noSkippedTests": "error",
        "noUnassignedVariables": "error",
        "noUnnecessaryConditions": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "useArraySortCompare": "error",
        "useAwait": "error",
        "useErrorMessage": "error",
        "useGuardForIn": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useStaticResponseMethods": "error",
        "noConditionalExpect": "error",
        "noDuplicateSelectors": "error",
        "noEmptyObjectKeys": "error",
        "noIdenticalTestTitle": "error",
        "noLoopFunc": "error",
        "noUntrustedLicenses": "error",
        "useBaseline": "error",
        "useExpect": "error"
      },
      "security": {
        "useIframeSandbox": "error"
      }
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "useExplicitReturnType": "error"
          }
        }
      }
    },
    {
      "includes": ["*.config.*"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app.html"],
      "linter": {
        "rules": {
          "nursery": {
            "noNonScalableViewport": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
